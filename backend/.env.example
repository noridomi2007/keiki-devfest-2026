# 1. Google Gemini API (Lấy tại Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# 2. Bảo mật Phiên & Chế độ Vận hành
# BẮT BUỘC đặt chuỗi ngẫu nhiên cố định (64 ký tự hex) khi deploy lên Cloud Run / Production để không bị đăng xuất khi container restart
APP_ENV=development
SESSION_SECRET=
ADMIN_TOKEN=
TRUST_PROXY_HEADERS=false

# 3. Google OAuth 2.0 Sign-In & Danh sách tên miền hợp lệ (Production HTTPS)
GOOGLE_CLIENT_ID=407438910099-fbr88s4baevcju84kqumkt9mkks9v60h.apps.googleusercontent.com
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173

# 4. Google Cloud Platform (Tùy chọn ở Local; điền khi deploy lên Cloud Run để lưu chứng từ lên GCS)
GCP_PROJECT=
GCS_BUCKET=

# 5. Giới hạn tải lên
MAX_UPLOAD_MB=8
